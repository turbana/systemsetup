## Media server configuration

# Each service needs it's own api key
lidarr_api_key: xxx
sabnzbd_api_key: xxx
sonarr_api_key: xxx
radarr_api_key: xxx
prowlarr_api_key: xxx

# plex setup
plex_claim_token: xxx

# nzbfinder setup
nzbfinder_api_key: xxx

# setup sabnzbd servers
sabnzbd_servers:
  servername_inside_sabnzbd:
    host: host.example.com
    port: 563
    username: xxx
    password: xxx
    required: 1
