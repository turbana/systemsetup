## DNS Configuration

# NOTE: cloudflare is the only supported registrar currently.
# See the following for the meaning of each value:
#   https://github.com/K0p1-Git/cloudflare-ddns-updater/blob/main/cloudflare-template.sh

dns:
  my.domain.com:
    registrar: cloudflare
    auth_key: xxx
    auth_email: xxx
    auth_method: token
    zone_id: xxx
    ttl: 3600
    proxy: false
    sitename:
    slackuri:
    slackchannel:
    discorduri:
